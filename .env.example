# ── Database ──────────────────────────────────────────────────────────────────
# Full PostgreSQL connection string. Replace <PASSWORD> with your actual password.
DATABASE_URL=postgresql://postgres:<PASSWORD>@localhost:5432/infragenie

# Redis connection string.
REDIS_URL=redis://localhost:6379

# ── LLM (OpenAI-compatible vLLM endpoint) ────────────────────────────────────
# Base URL of the vLLM server — must include /v1. No trailing slash.
LLM_BASE_URL=http://<LLM_SERVER_IP>:8000/v1

# API key for the LLM server. Leave empty for unauthenticated endpoints.
LLM_API_KEY=

# Exact model name as served by the vLLM instance.
LLM_MODEL=Qwen/Qwen3-Coder-Next-FP8

# ── Auth / JWT ────────────────────────────────────────────────────────────────
# Strong random secret used to sign JWT tokens. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=<GENERATE_A_SECURE_SECRET>

# JWT token lifetime in minutes (default: 1440 = 24 hours).
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── SMTP / Email OTP ──────────────────────────────────────────────────────────
# Leave SMTP_HOST empty to skip email sending (OTP is printed to console in dev).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_FROM_EMAIL=
# For Gmail: generate an App Password at https://myaccount.google.com/apppasswords
SMTP_PASSWORD=
SMTP_USE_TLS=true

# OTP expiry in minutes.
EMAIL_OTP_EXPIRE_MINUTES=10

# ── App ───────────────────────────────────────────────────────────────────────
# Set to "production" in live environments.
APP_ENV=development

# Origin of the frontend (used for CORS).
FRONTEND_URL=http://localhost:5173

# Base URL the frontend uses to reach the API (used by Vite / Docker).
VITE_API_URL=http://localhost:8000
